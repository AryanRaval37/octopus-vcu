# Low cell voltage: torque fades between 3300 and 3000 mV.
#
# A fade, not a cut. The pack sags under load, so cutting torque at a
# threshold makes the voltage recover, torque comes back, it sags again,
# and the car surges.

t=0      expect_state=LV_READY
t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE
t=3300   brake=0

# 3800 mV, healthy: 100.0 Nm at 50 % pedal.
t=3400   pedal=500
t=3600   expect_torque_min=990 expect_torque_max=1010

# 3400 mV is above the band. Nothing should change.
t=3800   cell_mv=3400
t=4000   expect_torque_min=990 expect_no_fault=CELL_UNDERVOLT

# 3150 mV is halfway down: half torque, and the fault is logged.
t=4200   cell_mv=3150
t=4400   expect_torque_min=450 expect_torque_max=550
t=4500   expect_fault=CELL_UNDERVOLT

# Below 3000 mV nothing is left, but we stay in DRIVE with the AIRs closed.
# A flat pack is a reason to stop drawing current, not to drop HV.
t=5000   cell_mv=2950
t=5300   expect_torque_max=0 expect_state=DRIVE expect_air_pos=1

# Recovers by itself. 2 s heal on the fault.
t=6000   cell_mv=3800
t=6400   expect_torque_min=990
t=8200   expect_no_fault=CELL_UNDERVOLT
