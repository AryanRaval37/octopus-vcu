# The datalog. If it quietly stops recording we find out after the run we
# needed it for, so check rows are appearing and none are being dropped.

t=0      expect_state=LV_READY

# 10 Hz heartbeat even when nothing is happening.
t=900    expect_log_min=8

t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE
t=3300   brake=0
t=3400   pedal=500

# ~3.5 s of heartbeat plus the state changes.
t=3600   expect_log_min=35

# The fault gets a row on the tick it sets, not at the next heartbeat.
t=4000   apps2_duty=400
t=4150   expect_fault=APPS_IMPLAUSIBLE
t=4160   expect_log_min=40

# Nothing should be dropped in a run this short. If this fails, something is
# writing a row every tick.
t=4200   expect_log_dropped=0
