# T11.9.2.d: digitally transmitted signals have to survive data corruption
# (checksum) and loss and delay of messages (timeouts). Losing a device
# entirely is 05. This one is the two sneakier cases.

t=0      expect_state=LV_READY
t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE
t=3300   brake=0
t=3400   pedal=500
t=3600   expect_torque_min=1

# The inverter keeps sending, checksums fine, but the rolling counter stops
# moving: same frame over and over. A timeout never sees this.
t=4000   inv_stuck=1
t=4100   expect_no_fault=INVERTER_TIMEOUT
t=4200   expect_no_fault=INVERTER_STALE

# 300 ms of a frozen counter.
t=4350   expect_fault=INVERTER_STALE expect_no_fault=INVERTER_TIMEOUT
t=4400   expect_state=FAULT expect_torque_max=0 expect_air_pos=0

# Counter moves again, fault heals after 1 s, driver re-arms.
t=5000   inv_stuck=0
t=6100   expect_no_fault=INVERTER_STALE
t=6300   ts=0
t=6500   expect_state=LV_READY

# BMS frames start failing their checksum. CORRUPT on its own is a warning
# (one bad frame on a noisy bus shouldn't stop the car), but bad frames
# don't count as heard-from, so after the timeout it's a BMS_TIMEOUT too.
t=6600   ts=1
t=7000   bms_crc_bad=1
t=7050   expect_fault=BMS_CORRUPT
t=7250   expect_fault=BMS_TIMEOUT
t=7300   expect_state=FAULT

# 1 s heal on CORRUPT, from the first good frame at t=8000.
t=8000   bms_crc_bad=0
t=8500   expect_fault=BMS_CORRUPT
t=9100   expect_no_fault=BMS_CORRUPT
