# The normal start-up. If this one fails, fix it before anything else.

t=0      expect_state=LV_READY

# TS on. AIR- and the precharge relay close, AIR+ stays open until the DC
# link reaches 95 % of the pack (EV5.7.1).
t=100    ts=1
t=150    expect_state=PRECHARGE expect_air_pos=0 expect_air_neg=1

# 400 V pack through a 400 ms RC is about 1.2 s to 95 %.
t=1500   expect_state=RTD_WAIT expect_air_pos=1

# Brake on, then press R2D (EV4.11.7). We're in R2D on the press, with the
# brake still held, and the sound plays over the first 1.5 s (EV4.12.1).
t=1600   brake=400
t=1700   rtd=1
t=1700   expect_state=DRIVE expect_enable=1 expect_buzzer=1
t=1800   rtd=0
t=3199   expect_buzzer=1
t=3200   expect_buzzer=0 expect_state=DRIVE

# Off the brake, onto the throttle.
t=3300   brake=0
t=3500   pedal=500
t=4000   expect_torque_min=1
