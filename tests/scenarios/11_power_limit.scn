# EV2.2.1 / EV2.2.2: 80 kW and 500 A at the accumulator outlet.
#
# Those are electrical, and all we control is shaft torque, so the VCU
# scales the limit by drive_efficiency (90 % by default) first:
# 80 kW electrical -> 72 kW at the shaft. Then T[0.1 Nm] = P * 95.493 / rpm.
#
# The BMS discharge limit goes through the same sum (amps * pack volts =
# watts), and the lowest ceiling wins.
#
# The plant keeps integrating rpm after we set it, so the numbers below
# have a little slack for the motor speeding up between set and check.

t=0      expect_state=LV_READY
t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE
t=3300   brake=0

# Flat out at low speed. Power isn't the limit down here, the torque map
# is: full 200.0 Nm.
t=3400   pedal=1000 rpm=500
t=3500   expect_torque_min=1950 expect_torque_max=2000

# 4000 rpm: 72 kW is 171.9 Nm, below the map.
t=4000   rpm=4000
t=4100   expect_torque_max=1720 expect_torque_min=1680

# 5000 rpm: 137.5 Nm.
t=4500   rpm=5000
t=4600   expect_torque_max=1380 expect_torque_min=1340

# BMS says 50.0 A. At 400 V that's 20 kW, 18 kW at the shaft, 43.0 Nm at
# 4000 rpm. Well under both the map and the rule.
t=5000   rpm=4000 amp_limit=500
t=5150   expect_torque_max=440 expect_torque_min=410

# Give it the current back.
t=6000   amp_limit=2000
t=6200   expect_torque_min=1650
