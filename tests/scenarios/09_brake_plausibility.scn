# Brake sensor pair.
#
# T6.1.13 allows regen on brake pedal travel, which makes the brake signals
# torque-influencing and so SCSs under T11.9.1. They get the same treatment
# as the APPS: range check each channel and compare the two.

t=0      expect_state=LV_READY
t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE

# Both at 40 %.
t=3250   expect_brake_min=395 expect_brake_max=405

# Channel 2 sags. The brake believes the higher channel, so it still reads
# 40 %.
t=3300   brake2_mv=1000
t=3350   expect_brake_min=395

# Past 250 ms it's implausible. LIMP: no torque, HV stays up.
t=3600   expect_fault=BRAKE_IMPLAUSIBLE
t=3650   expect_torque_max=0 expect_state=DRIVE expect_air_pos=1

# Agreeing again doesn't clear it, releasing the pedal does.
t=4000   brake=400
t=4200   expect_fault=BRAKE_IMPLAUSIBLE
t=4500   brake=0
t=4700   expect_no_fault=BRAKE_IMPLAUSIBLE

# A channel out of range is a wiring fault: CRITICAL, SDC and AIRs open
# (T11.9.5).
t=5000   brake1_mv=100
t=5100   expect_fault=BRAKE_RANGE
t=5200   expect_state=FAULT expect_air_pos=0
