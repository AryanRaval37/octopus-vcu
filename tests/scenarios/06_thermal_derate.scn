# Motor overtemperature: torque fades out between 90 and 110 C instead of
# cutting off.
#
# (This path never ran for a while: the plant integrated temperature with
# integer division at a 1 ms tick, so it sat at 25 C forever.)

t=0      expect_state=LV_READY
t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE
t=3300   brake=0

# 50 % pedal, cold: 100.0 Nm.
t=3400   pedal=500
t=3600   expect_torque_min=990 expect_torque_max=1010

# 100 C is halfway through the band, so half torque.
t=4000   temp_motor=100
t=4200   expect_torque_min=450 expect_torque_max=550

# OVERTEMP_MOTOR goes up once the fade has been biting for its 500 ms
# debounce. It's a DERATE fault, so it's there for the log and the car
# stays in DRIVE.
t=4250   expect_no_fault=OVERTEMP_MOTOR
t=4600   expect_fault=OVERTEMP_MOTOR expect_state=DRIVE

# 105 C leaves a quarter.
t=4500   temp_motor=105
t=4700   expect_torque_min=200 expect_torque_max=300

# Past 110 C there's nothing left, still in DRIVE.
t=5000   temp_motor=115
t=5200   expect_torque_max=0
t=5600   expect_fault=OVERTEMP_MOTOR expect_state=DRIVE

# Cools down, torque comes back by itself. No latch, the temperature
# dropping is the evidence it's fine.
t=6000   temp_motor=60
t=6400   expect_torque_min=990

# 5 s heal from t=6000. Checked a bit after 11000 rather than on it, so the
# check doesn't depend on exactly which tick it lands on.
t=11200  expect_no_fault=OVERTEMP_MOTOR
