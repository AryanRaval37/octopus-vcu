# EV4.11.8: "The ready-to-drive mode must be left immediately when the
# shutdown circuit is opened."
#
# The inertia switch, the shutdown buttons and the BOTS are all on this
# loop, so this is the path for someone hitting a stop button.

t=0      expect_state=LV_READY
t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE
t=3300   brake=0
t=3400   pedal=500
t=3600   expect_torque_min=1 expect_enable=1

# Someone hits a shutdown button. No debounce, "immediately" is the rule.
t=4000   sdc=0
t=4001   expect_fault=SDC_OPEN expect_state=FAULT
t=4010   expect_torque_max=0 expect_enable=0
t=4020   expect_air_pos=0 expect_air_neg=0

# The loop is already open, so the VCU has no reason to hold its own
# switch open too. (If it did, and the sense point is after that switch,
# it would never see the loop close again.)
t=4020   expect_sdc_assert=0

# EV4.11.4: closing the loop again must not restart the TS by itself.
t=5000   sdc=1
t=6000   expect_state=FAULT

# Open it again, and this time let go of TS while it's still open. That
# must not get us out of FAULT: the loop is still open.
t=6200   sdc=0
t=6500   ts=0
t=7000   expect_state=FAULT expect_fault=SDC_OPEN

# Close it. SDC_OPEN heals after 500 ms and we drop back to LV_READY.
t=7200   sdc=1
t=7600   expect_state=FAULT
t=7800   expect_state=LV_READY expect_no_fault=SDC_OPEN

# Asking again is the "additional action", and precharge starts.
t=8000   ts=1
t=8050   expect_state=PRECHARGE
