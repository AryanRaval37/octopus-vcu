# APPS channels disagreeing.
#
# T11.8.9: implausibility is "a deviation of more than ten percentage points
# pedal travel between any of the used APPSs". T11.8.8: if it lasts more
# than 100 ms, motor power off, but "it is not necessary to completely
# deactivate the tractive system". So torque goes to zero, the AIRs stay
# closed, and the driver recovers by lifting off.
#
# (A channel that's actually broken is a different fault with a different
# response, see 16_apps_wiring.scn.)

t=0      expect_state=LV_READY
t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE
t=3300   brake=0

t=3400   pedal=450
t=3450   expect_torque_min=1 expect_no_fault=APPS_IMPLAUSIBLE

# APPS2 drifts: 400 is ~62 % on its scale while APPS1 still says 45 %.
t=3500   apps2_duty=400

# Still inside the 100 ms.
t=3550   expect_no_fault=APPS_IMPLAUSIBLE

# Past it: latched, no torque, inverter disabled.
t=3620   expect_fault=APPS_IMPLAUSIBLE expect_torque_max=0 expect_enable=0

# HV stays up (T11.8.8), so recovering doesn't need a full restart.
t=3630   expect_state=DRIVE expect_air_pos=1

# Agreeing again isn't enough...
t=4000   apps2_duty=540
t=4200   expect_fault=APPS_IMPLAUSIBLE expect_torque_max=0

# ...the pedal has to come back under 5 %.
t=5000   pedal=0
t=5200   expect_no_fault=APPS_IMPLAUSIBLE
