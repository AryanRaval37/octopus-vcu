# Brake and throttle together (BPPC).
#
# A6.4.4 lists a working "APPS/brake pedal plausibility check" as required
# to run the car, but FB2027 doesn't give numbers. 25 % to trip and 5 % to
# reset are from the older FSAE/FSG rules.
#
# Only lifting the throttle clears it. Letting go of the brake doesn't,
# because with a stuck throttle that's the last thing a startled driver
# will do.
#
# Not the BSPD, which is separate hardware (T11.6).

t=0      expect_state=LV_READY
t=100    ts=1
t=1500   rtd=1 brake=400
t=3200   expect_state=DRIVE
t=3300   brake=0

t=3400   pedal=600
t=3500   expect_torque_min=1

# Brakes hard without lifting.
t=3600   brake=500
t=3700   expect_fault=BPPC expect_torque_max=0

# Off the brake: still latched.
t=4000   brake=0
t=4200   expect_fault=BPPC expect_torque_max=0

# 10 % throttle: still latched, the reset is 5 %.
t=4500   pedal=100
t=4700   expect_fault=BPPC expect_torque_max=0

# Under 5 %: cleared, and torque comes back.
t=5000   pedal=0
t=5200   expect_no_fault=BPPC
t=5400   pedal=600
t=5800   expect_torque_min=1
