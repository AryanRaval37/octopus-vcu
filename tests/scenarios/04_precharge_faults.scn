# Precharge resistor open: the DC link never rises.
#
# Closing AIR+ onto an uncharged link is how contactors get welded, so
# this has to end in FAULT with AIR+ never having closed.

t=0      pc_open=1
t=100    ts=1
t=200    expect_state=PRECHARGE expect_air_pos=0

# The "is it moving at all?" check at 500 ms catches it well before the
# 5 s timeout would.
t=700    expect_fault=PRECHARGE_NO_RISE
t=750    expect_state=FAULT expect_air_pos=0 expect_torque_max=0

t=1000   expect_air_pos=0
t=5000   expect_air_pos=0
